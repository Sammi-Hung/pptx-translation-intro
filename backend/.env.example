APP_ENV=development
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=50
RETENTION_MINUTES=30
CLEANUP_INTERVAL_SECONDS=300

# mock | openai | google | gemini | ollama | external
TRANSLATION_PROVIDER=mock
#
# Cloud Gemini example:
# TRANSLATION_PROVIDER=gemini
# TRANSLATION_API_KEY=<your-gemini-api-key>
# TRANSLATION_API_URL=
# TRANSLATION_MODEL=gemini-3-flash-preview
#
# Local Ollama example:
# TRANSLATION_PROVIDER=ollama
# TRANSLATION_API_KEY=
# TRANSLATION_API_URL=http://your-ollama-host:11434/v1
# TRANSLATION_MODEL=your-local-model
# Leave empty to let the Ollama host decide GPU usage.
# Set 0 only when you explicitly need to force CPU for troubleshooting.
# TRANSLATION_OLLAMA_NUM_GPU=
TRANSLATION_API_KEY=
TRANSLATION_API_URL=
TRANSLATION_MODEL=gemini-3-flash-preview
TRANSLATION_OLLAMA_NUM_GPU=
TRANSLATION_CLOUD_PROVIDER=gemini
TRANSLATION_CLOUD_API_URL=
TRANSLATION_CLOUD_MODEL=gemini-3-flash-preview
TRANSLATION_LOCAL_PRIMARY_API_URL=http://your-primary-ollama-host:11434/v1
TRANSLATION_LOCAL_PRIMARY_MODEL=your-primary-model
TRANSLATION_LOCAL_SECONDARY_API_URL=http://your-secondary-ollama-host:11434/v1
TRANSLATION_LOCAL_SECONDARY_MODEL=your-secondary-model

# mock | sapi | external
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_API_URL=

# mock | com
# Use mock for local development without launching Microsoft PowerPoint.
# Use com on a Windows machine with Microsoft PowerPoint installed.
AUDIO_EMBED_PROVIDER=mock

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
